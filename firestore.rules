rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Primitives
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return isSignedIn() && (
        (request.auth.token.get('email', '').lower() == "yirsawbiniyam@gmail.com") ||
        (request.auth.token.get('email', '').lower() == "policeregion551@gmail.com") ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('email', '').lower() == "policeregion551@gmail.com" ||
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('email', '').lower() == "yirsawbiniyam@gmail.com"))
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
 
    function isActive() {
      return isGlobalAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        getUserData().get('active', false) == true
      );
    }
 
    function isAdmin() {
      return isGlobalAdmin() || (
        isActive() && 
        getUserData().get('role', '') == 'Administrator'
      );
    }
 
    function isDataEntry() {
      return isAdmin() || (
        isActive() && 
        getUserData().get('role', '') == 'Data Entry'
      );
    }
 
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
 
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
 
    // ===============================================================
    // Domain Validation Blueprints
    // ===============================================================
    function isValidIDRecord(data) {
      return data.id_number is string && data.id_number.size() > 0 &&
             data.full_name_am is string && data.full_name_am.size() > 0 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.created_by_email is string;
    }
 
    // ===============================================================
    // Collection Rules
    // ===============================================================
 
    match /ids/{id} {
      allow get: if true;
      allow list: if isGlobalAdmin() || (isActive() && (
        isAdmin() || 
        (resource.data.get('created_by_email', '') == getUserData().get('email', '')) ||
        (resource.data.get('status', '') == 'approved')
      ));
 
      allow create: if isDataEntry() && isValidIDRecord(incoming()) && (
        isAdmin() || (incoming().get('status', '') == 'pending' && incoming().get('created_by_email', '') == getUserData().get('email', ''))
      );
 
      allow update: if isActive() && (
        isAdmin() || 
        (isDataEntry() && existing().get('created_by_email', '') == getUserData().get('email', '') && existing().get('status', '') == 'pending' && 
         incoming().get('status', '') == 'pending' && incoming().get('created_by_email', '') == existing().get('created_by_email', ''))
      );
 
      allow delete: if isAdmin();
    }
 
    match /users/{userId} {
      allow read, write: if isGlobalAdmin() || isAdmin();
      allow list: if true; 
    }

    match /profiles/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isGlobalAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || isGlobalAdmin();
    }

    match /scans/{scanId} {
      allow read: if isDataEntry();
      allow create: if true;
    }

    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
