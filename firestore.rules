rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Primitives
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isRealAuthSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' && (
          request.auth.token.get('email', '').lower() == 'policeregion551@gmail.com' ||
          request.auth.token.get('email', '').lower() == 'yirsawbiniyam@gmail.com'
        );
    }

    function hasValidProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isRealAuthSuperAdmin() || (
        hasValidProfile() &&
        getUserData().get('active', false) == true &&
        getUserData().get('role', '') == 'Administrator' && (
          getUserData().get('email', '').lower() == 'policeregion551@gmail.com' ||
          getUserData().get('email', '').lower() == 'yirsawbiniyam@gmail.com'
        )
      );
    }

    function isActive() {
      return isSuperAdmin() || (
        hasValidProfile() &&
        getUserData().get('active', false) == true
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isActive() &&
        getUserData().get('role', '') == 'Administrator'
      );
    }

    function isApprover() {
      return isAdmin() || (
        isActive() &&
        getUserData().get('role', '') == 'Approver'
      );
    }

    function isDataEntry() {
      return isAdmin() || (
        isActive() &&
        getUserData().get('role', '') == 'Data Entry'
      );
    }

    function isAuthorizedPrinter() {
      return isAdmin() || isApprover() || isDataEntry();
    }

    function currentUserEmail() {
      return request.auth.token.get('email', '') != ''
        ? request.auth.token.get('email', '').lower()
        : (hasValidProfile() ? getUserData().get('email', '').lower() : '');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidProfileDoc(data) {
      return data.keys().hasAll(['email', 'username', 'role', 'active', 'last_login']) &&
        data.keys().hasOnly(['email', 'username', 'role', 'active', 'last_login', 'user_doc_id']) &&
        data.email is string && data.email.size() <= 200 &&
        data.username is string && data.username.size() > 0 && data.username.size() <= 120 &&
        data.role in ['Administrator', 'Approver', 'Data Entry', 'Viewer'] &&
        data.active is bool &&
        data.last_login is string && data.last_login.size() <= 64 &&
        (
          isRealAuthSuperAdmin() ||
          (
            data.keys().hasAll(['user_doc_id']) &&
            isValidId(data.user_doc_id) &&
            exists(/databases/$(database)/documents/users/$(data.user_doc_id)) &&
            get(/databases/$(database)/documents/users/$(data.user_doc_id)).data.get('active', true) == true &&
            get(/databases/$(database)/documents/users/$(data.user_doc_id)).data.role == data.role
          )
        );
    }

    function allowedIdKeys() {
      return [
        'id_number', 'full_name_am', 'full_name_en', 'rank_am', 'rank_en',
        'responsibility_am', 'responsibility_en', 'phone', 'photo_url',
        'blood_type', 'badge_number', 'fayda_number', 'gender', 'complexion',
        'height', 'emergency_contact_name', 'emergency_contact_phone',
        'commissioner_signature', 'member_signature', 'issued_at', 'expires_at',
        'created_at', 'updated_at', 'deleted', 'deleted_at', 'status',
        'is_registered', 'approved_by', 'approved_at', 'correction_note',
        'reviewed_by', 'reviewed_at', 'resubmitted', 'resubmitted_at',
        'created_by_email'
      ];
    }

    function isValidIdRecordFields(data) {
      return data.keys().hasAll(['id_number', 'status']) &&
        data.id_number is string && data.id_number.size() > 0 && data.id_number.size() <= 64 &&
        data.status in ['pending', 'needs_correction', 'approved', 'rejected'] &&
        (!('full_name_am' in data) || data.full_name_am == null || (data.full_name_am is string && data.full_name_am.size() <= 200)) &&
        (!('full_name_en' in data) || data.full_name_en == null || (data.full_name_en is string && data.full_name_en.size() <= 200)) &&
        (!('rank_am' in data) || data.rank_am == null || (data.rank_am is string && data.rank_am.size() <= 140)) &&
        (!('rank_en' in data) || data.rank_en == null || (data.rank_en is string && data.rank_en.size() <= 140)) &&
        (!('responsibility_am' in data) || data.responsibility_am == null || (data.responsibility_am is string && data.responsibility_am.size() <= 200)) &&
        (!('responsibility_en' in data) || data.responsibility_en == null || (data.responsibility_en is string && data.responsibility_en.size() <= 200)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 40)) &&
        (!('fayda_number' in data) || data.fayda_number == null || (data.fayda_number is string && data.fayda_number.size() <= 64)) &&
        (!('badge_number' in data) || data.badge_number == null || (data.badge_number is string && data.badge_number.size() <= 64)) &&
        (!('photo_url' in data) || data.photo_url == null || (data.photo_url is string && data.photo_url.size() <= 1000000)) &&
        (!('commissioner_signature' in data) || data.commissioner_signature == null || (data.commissioner_signature is string && data.commissioner_signature.size() <= 600000)) &&
        (!('member_signature' in data) || data.member_signature == null || (data.member_signature is string && data.member_signature.size() <= 600000));
    }

    function isValidIdRecord(data) {
      return data.keys().hasOnly(allowedIdKeys()) && isValidIdRecordFields(data);
    }

    function isValidUserRecord(data) {
      return data.keys().hasAll(['role', 'password']) &&
        data.keys().hasOnly(['username', 'username_lower', 'email', 'password', 'role', 'active', 'created_at', 'updated_at']) &&
        data.role in ['Administrator', 'Approver', 'Data Entry', 'Viewer'] &&
        data.password is string && data.password.size() > 0 && data.password.size() <= 256 &&
        data.get('username', '') is string && data.get('username', '').size() <= 120 &&
        data.get('email', '') is string && data.get('email', '').size() <= 200;
    }

    function isValidPrintLog(data) {
      return data.keys().hasAll(['id_number', 'id_doc_id', 'user_email', 'user_role', 'side', 'uid', 'timestamp']) &&
        data.keys().hasOnly(['id_number', 'id_doc_id', 'user_email', 'user_role', 'side', 'uid', 'timestamp']) &&
        data.id_number is string && data.id_number.size() > 0 && data.id_number.size() <= 64 &&
        data.id_number.matches('^[A-Za-z0-9_\\-]+$') &&
        data.id_doc_id is string && data.id_doc_id.size() > 0 && data.id_doc_id.size() <= 128 &&
        data.id_doc_id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.user_email is string && data.user_email.size() > 0 && data.user_email.size() <= 200 &&
        data.user_role in ['Administrator', 'Approver', 'Data Entry'] &&
        data.side in ['front', 'back', 'both', 'combined'] &&
        data.uid is string && data.uid == request.auth.uid &&
        data.timestamp == request.time;
    }

    function isValidScanLog(data) {
      return data.keys().hasAll(['id_number', 'timestamp']) &&
        data.keys().hasOnly(['id_number', 'status_at_scan', 'timestamp', 'ip', 'user_agent']) &&
        data.id_number is string && data.id_number.size() > 0 && data.id_number.size() <= 64 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64 &&
        data.get('user_agent', '') is string && data.get('user_agent', '').size() <= 512;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /ids/{id} {
      // Only active authenticated staff can fetch individual ID documents directly;
      // anonymous QR verification queries are strictly capped to limit(1).
      allow get: if isSignedIn() && isValidId(id) && isActive();
      allow list: if (isSignedIn() && isActive()) || (
        isSignedIn() &&
        request.query.limit != null &&
        request.query.limit <= 1
      );
      allow create: if isSignedIn() && isValidId(id) && isValidIdRecord(incoming()) && (
        isApprover() || (
          isDataEntry() &&
          incoming().status == 'pending' &&
          incoming().get('is_registered', false) == false &&
          incoming().get('deleted', false) == false
        )
      );
      allow update: if isSignedIn() && isValidId(id) && isValidIdRecordFields(incoming()) && (
        isValidIdRecord(incoming()) ||
        incoming().diff(existing()).affectedKeys().hasOnly(allowedIdKeys())
      ) && (
        isAdmin() ||
        isApprover() || (
          isDataEntry() &&
          existing().status != 'approved' &&
          incoming().status in ['pending', 'needs_correction'] &&
          incoming().get('is_registered', false) == false &&
          incoming().get('deleted', false) == false
        )
      );
      allow delete: if isAdmin() && isValidId(id);
    }

    match /users/{userId} {
      // Prevent bulk scraping of staff credentials/emails by unauthenticated or anonymous users.
      // Single-record lookup (limit <= 1) is permitted for login verification only.
      allow get: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (hasValidProfile() && getUserData().get('user_doc_id', '') == userId)
      );
      allow list: if isAdmin() || (
        isSignedIn() &&
        request.query.limit != null &&
        request.query.limit <= 1
      );
      allow create: if isAdmin() && isValidId(userId) && isValidUserRecord(incoming());
      allow update: if isValidId(userId) && (
        (isAdmin() && incoming().role in ['Administrator', 'Approver', 'Data Entry', 'Viewer'] && incoming().password is string && incoming().password.size() <= 256) || (
          isSignedIn() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['password']) &&
          !(existing().password.matches('^pbkdf2_sha256\\$.*')) &&
          incoming().password is string &&
          incoming().password.matches('^pbkdf2_sha256\\$.*') &&
          incoming().password.size() <= 256
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /profiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidProfileDoc(incoming());
      allow delete: if isAdmin();
    }

    match /scans/{scanId} {
      allow read: if isSignedIn() && isActive();
      allow create: if isSignedIn() && isValidId(scanId) && isValidScanLog(incoming());
      allow update, delete: if false;
    }

    match /assets/{assetId} {
      // Allow individual gets for public branding assets before login (Login & QR screens);
      // sensitive assets (commissioner_signature) require an active authenticated staff profile.
      allow get: if isValidId(assetId) && (
        assetId in ['police_logo', 'bgr_flag', 'eth_flag'] ||
        (isSignedIn() && isActive())
      );
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(assetId) &&
        incoming().keys().hasAll(['value']) &&
        incoming().keys().hasOnly(['value', 'updated_at']) &&
        incoming().value is string && incoming().value.size() <= 1000000 &&
        incoming().get('updated_at', '') is string && incoming().get('updated_at', '').size() <= 64;
      allow delete: if isAdmin() && isValidId(assetId);
    }

    match /print_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (
        isApprover() || existing().uid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isApprover() || resource.data.uid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        isValidId(logId) &&
        isValidPrintLog(incoming()) &&
        isAuthorizedPrinter() &&
        (isSuperAdmin() || incoming().user_email == currentUserEmail()) &&
        exists(/databases/$(database)/documents/ids/$(incoming().id_doc_id)) &&
        get(/databases/$(database)/documents/ids/$(incoming().id_doc_id)).data.id_number == incoming().id_number &&
        get(/databases/$(database)/documents/ids/$(incoming().id_doc_id)).data.status == 'approved' &&
        get(/databases/$(database)/documents/ids/$(incoming().id_doc_id)).data.get('deleted', false) != true;
      allow update, delete: if false;
    }
  }
}
