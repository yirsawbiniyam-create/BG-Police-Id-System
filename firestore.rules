rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Primitives
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '').lower() == 'policeregion551@gmail.com' ||
        request.auth.token.get('email', '').lower() == 'yirsawbiniyam@gmail.com'
      );
    }

    function hasValidProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSuperAdmin() || (
        hasValidProfile() && 
        getUserData().get('active', false) == true
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isActive() && 
        getUserData().get('role', '') == 'Administrator'
      );
    }

    function isDataEntry() {
      return isAdmin() || (
        isActive() && 
        getUserData().get('role', '') == 'Data Entry'
      );
    }

    function currentUserEmail() {
      return isSuperAdmin() ? request.auth.token.get('email', '') : (hasValidProfile() ? getUserData().get('email', '') : '');
    }
 
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
 
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
 
    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /ids/{id} {
      allow get: if true;
      allow list: if isAdmin() || 
                    (isActive() && resource.data.get('created_by_email', '') == currentUserEmail()) || 
                    (resource.data.get('status', '') == 'approved');
 
      allow create: if isActive() && isDataEntry() && (
        isAdmin() || (incoming().get('status', '') == 'pending' && incoming().get('created_by_email', '') == currentUserEmail())
      );
 
      allow update: if isActive() && (
        isAdmin() || 
        (isDataEntry() && existing().get('created_by_email', '') == currentUserEmail() && existing().get('status', '') == 'pending' && 
         incoming().get('status', '') == 'pending' && incoming().get('created_by_email', '') == existing().get('created_by_email', ''))
      );
 
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isSuperAdmin() || isAdmin();
      allow list: if true; 
    }

    match /profiles/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
    }

    match /scans/{scanId} {
      allow read: if isDataEntry();
      allow create: if true;
    }

    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
