rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Primitives
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      // Profiles indexed by UID provide a secure lookup for roles and active status
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
 
    function isActive() {
      return isSignedIn() && (getUserData().active == true);
    }
 
    function isAdmin() {
      return isActive() && (
        getUserData().role == 'Administrator' || 
        request.auth.token.email == "yirsawbiniyam@gmail.com" ||
        request.auth.token.email == "policeregion551@gmail.com"
      );
    }
 
    function isDataEntry() {
      return isActive() && (getUserData().role == 'Data Entry' || isAdmin());
    }
 
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
 
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
 
    // ===============================================================
    // Domain Validation Blueprints
    // ===============================================================
    function isValidIDRecord(data) {
      return data.id_number is string && data.id_number.size() > 0 && data.id_number.size() <= 50 &&
             data.full_name_am is string && data.full_name_am.size() > 0 && data.full_name_am.size() <= 200 &&
             data.full_name_en is string && data.full_name_en.size() > 0 && data.full_name_en.size() <= 200 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.created_by_email is string && data.created_by_email.size() <= 100;
    }
 
    // ===============================================================
    // Collection Rules
    // ===============================================================
 
    match /ids/{id} {
      // Public verification by ID number (get only, no listing)
      allow get: if true;
      
      // List records: Admin sees all, Data Entry sees what they created, Viewers see approved
      allow list: if isActive() && (
        isAdmin() || 
        (isDataEntry() && existing().created_by_email == getUserData().email) ||
        (existing().status == 'approved')
      );
 
      allow create: if isDataEntry() && isValidIDRecord(incoming()) && (
        // Enforcement: Pending status unless admin
        (isAdmin() || incoming().status == 'pending') &&
        // Enforcement: identity integrity
        incoming().created_by_email == getUserData().email
      );
 
      allow update: if isActive() && (
        // Admin can update anything
        (isAdmin() && isValidIDRecord(incoming())) ||
        // Data Entry can update their own PENDING records (e.g. fixing typos)
        (isDataEntry() && existing().created_by_email == getUserData().email && existing().status == 'pending' && 
         isValidIDRecord(incoming()) && incoming().status == 'pending' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['full_name_am', 'full_name_en', 'photo_url', 'phone', 'rank_am', 'rank_en', 'responsibility_am', 'responsibility_en', 'gender', 'blood_type', 'complexion', 'height', 'emergency_contact_name', 'emergency_contact_phone', 'member_signature', 'commissioner_signature', 'updated_at']))
      );
 
      allow delete: if isAdmin();
    }
 
    match /users/{userId} {
      // Admin only management
      allow read, write: if isAdmin();
      // Allow initial login check
      allow list: if true;
    }

    match /profiles/{uid} {
      // Mapping used for rules lookup
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid && 
                      get(/databases/$(database)/documents/users/$(incoming().email)).data.role == incoming().role;
      allow update: if isAdmin();
    }

    match /scans/{scanId} {
      allow read: if isDataEntry();
      allow create: if true;
    }

    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
